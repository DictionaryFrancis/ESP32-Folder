	(title_block
		(title "Nano ESP32 – Button-Controlled DC Motor")
		(date "2026-10-31")
		(rev "1.0")
		(comment 1 "Board: Arduino Nano ESP32 (ABX00083); powered via USB-C.")
		(comment 2 "SW1 connects D11 to GND; internal pull-up enabled")
		(comment 3 "L293D control: D5 → EN1,2; D4 → 1A; D3 → 2A")
		(comment 4 "External regulated 5 V supplies L293D pins 8 and 16")
		(comment 5 "Common GND connects the ESP32, motor driver and power supply")
		(comment 6 "Motor connected between 1Y (pin 3) and 2Y (pin 6)")
		(comment 7 "Motor operation confirmed; direction selected in firmware")
	)
